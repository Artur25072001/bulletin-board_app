<!DOCTYPE html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bulletin Board - Створити оголошення</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="container">
      <a href="/" class="btn-link btn-back">Назад</a>
      
      <form action="/announcements" method="POST">
        
        <div class="form-group radio-group">
          <label><strong>Категорія:</strong></label><br />
          
          <label>
            <input type="radio" name="category" value="sale" <%= data?.category === 'sale' ? 'checked' : '' %> required />
            📦 Продаж
          </label>
          
          <label>
            <input type="radio" name="category" value="service" <%= data?.category === 'service' ? 'checked' : '' %> />
            🔧 Послуги
          </label>
          
          <label>
            <input type="radio" name="category" value="job" <%= data?.category === 'job' ? 'checked' : '' %> />
            💼 Робота
          </label>
          
          <label>
            <input type="radio" name="category" value="other" <%= data?.category === 'other' ? 'checked' : '' %> />
            📌 Інше
          </label>

          <% if (typeof errors !== 'undefined' && errors.category) { %>
            <span class="error"><%= errors.category %></span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="title"><strong>Назва:</strong></label><br />
          <input 
            type="text" 
            id="title"
            name="title" 
            placeholder="Коротка назва оголошення" 
            minlength="5" 
            maxlength="100" 
            value="<%= data?.title || '' %>" 
            required 
          />
          <% if (typeof errors !== 'undefined' && errors.title) { %>
            <span class="error"><%= errors.title %></span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="description"><strong>Опис:</strong></label><br />
          <textarea 
            id="description"
            name="description" 
            rows="6" 
            placeholder="Детальний опис оголошення..." 
            minlength="10" 
            required
          ><%= data?.description || '' %></textarea>
          <% if (typeof errors !== 'undefined' && errors.description) { %>
            <span class="error"><%= errors.description %></span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="price"><strong>Ціна (грн):</strong></label><br />
          <input 
            type="number" 
            id="price"
            name="price" 
            min="0" 
            step="0.01" 
            value="<%= data?.price || '' %>" 
          />
          <% if (typeof errors !== 'undefined' && errors.price) { %>
            <span class="error"><%= errors.price %></span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="contact"><strong>Контактна інформація:</strong></label><br />
          <input 
            type="text" 
            id="contact"
            name="contact" 
            placeholder="Email або телефон" 
            minlength="5" 
            value="<%= data?.contact || '' %>" 
            required 
          />
          <% if (typeof errors !== 'undefined' && errors.contact) { %>
            <span class="error"><%= errors.contact %></span>
          <% } %>
        </div>

        <div class="form-group">
          <button type="submit">Опублікувати</button>
          <a href="/" style="margin-left: 10px; text-decoration: none; color: gray;">Скасувати</a>
        </div>

      </form>
    </div>
  </body>
</html>